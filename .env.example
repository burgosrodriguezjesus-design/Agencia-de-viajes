# ── Imprescindibles ────────────────────────────────────────────────────
# Supabase (base de datos, autenticación y almacenamiento de documentos)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# URL pública de la web (para enlaces de confirmación, compartir y Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Agentes de IA (Claude) ─────────────────────────────────────────────
# Sin esta clave la plataforma funciona en "modo básico" (itinerario
# algorítmico con datos abiertos) y los agentes aparecen como pendientes.
ANTHROPIC_API_KEY=
# Opcional: modelo del asistente y de los agentes especialistas
AGENT_MODEL=claude-opus-5-5
AGENT_SPECIALIST_MODEL=claude-opus-5-5

# ── Precios verificados (opcionales; sin ellas solo hay estimaciones) ──
# Vuelos: Duffel (https://duffel.com)
DUFFEL_ACCESS_TOKEN=
# Hoteles: LiteAPI / Nuitée (https://liteapi.travel)
LITEAPI_KEY=

# ── Suscripciones (Stripe) ─────────────────────────────────────────────
# Con estas DOS claves ya se puede cobrar: los precios salen de
# src/lib/billing/plans.ts y no hay que crear productos en Stripe.
STRIPE_SECRET_KEY=
# Clave secreta de Supabase (Settings → API Keys). La usa el servidor para
# activar el plan tras el pago. Nunca se expone al navegador.
SUPABASE_SECRET_KEY=
# Recomendado: firma del webhook (/api/stripe/webhook) para reflejar al
# instante renovaciones y cancelaciones.
STRIPE_WEBHOOK_SECRET=
# Opcional: usar precios ya creados en Stripe en lugar de los del código.
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# ── Afiliación (opcional) ──────────────────────────────────────────────
# Si se configuran, los enlaces de reserva llevan el identificador y se
# muestran como "enlace de afiliado". Nunca alteran el orden de resultados.
AFFILIATE_BOOKING_AID=
AFFILIATE_GETYOURGUIDE_PARTNER_ID=
AFFILIATE_VIATOR_PID=
AFFILIATE_SKYSCANNER_ASSOCIATE_ID=

# ── Datos abiertos ─────────────────────────────────────────────────────
# Wikimedia exige identificar la aplicación en el User-Agent.
OPEN_DATA_USER_AGENT=TravelPlannerMVP/0.1 (contacto: tu-email@dominio.com)
# Opcional pero recomendado en producción: token personal de Wikimedia
# (https://api.wikimedia.org) para evitar el límite de peticiones anónimas.
WIKIMEDIA_ACCESS_TOKEN=
